import java.util.*;

class Solution {
    public int[] arrayRankTransform(int[] arr) {
        int n = arr.length;

        int[] sorted = arr.clone();
        Arrays.sort(sorted);

        int unique = 0;

        for (int i = 0; i < n; i++) {
            if (i == 0 || sorted[i] != sorted[i - 1]) {
                sorted[unique++] = sorted[i];
            }
        }

        for (int i = 0; i < n; i++) {
            int left = 0;
            int right = unique - 1;
            int x = arr[i];

            while (left <= right) {
                int mid = (left + right) >>> 1;

                if (sorted[mid] < x) {
                    left = mid + 1;
                } else if (sorted[mid] > x) {
                    right = mid - 1;
                } else {
                    arr[i] = mid + 1;
                    break;
                }
            }
        }

        return arr;
    }
}
